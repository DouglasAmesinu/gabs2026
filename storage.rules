rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isDelegate() { return request.auth != null && request.auth.token.delegate == true; }
    function isAdmin() { return request.auth != null && request.auth.token.email == 'REPLACE_WITH_ADMIN_EMAIL'; }
    match /photos/{userId} {
      allow read: if true;
      allow write: if ((isDelegate() && request.auth.uid == userId) || isAdmin())
                   && request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
