rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isDelegate() { return signedIn() && request.auth.token.delegate == true; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'REPLACE_WITH_ADMIN_EMAIL'; }
    function inThread(t) { return isDelegate() && request.auth.uid in t.split('_'); }

    // Optional string field k of map d, at most max characters.
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }

    // Participant doc as the client writes it (claim form setDoc, Edit Profile
    // updateDoc, photoURL updates), plus status/source/registeredAt and the
    // server-written bookedSlots. phone is never written by the client but can
    // exist on admin-imported profiles. photoURL '' is "Remove photo".
    function validProfile(d) {
      return d.keys().hasOnly(['salutation','ptype','name','company','website','title','sector','country',
                               'linkedin','interests','bio','av','photoURL','status','source','registeredAt',
                               'bookedSlots','phone'])
        && optStr(d, 'name', 120) && optStr(d, 'company', 120) && optStr(d, 'title', 120)
        && optStr(d, 'bio', 600) && optStr(d, 'sector', 60) && optStr(d, 'country', 60)
        && optStr(d, 'ptype', 40) && optStr(d, 'salutation', 20) && optStr(d, 'website', 200)
        && optStr(d, 'linkedin', 200) && optStr(d, 'av', 3) && optStr(d, 'phone', 40)
        && (!('photoURL' in d) || (d.photoURL is string && d.photoURL.size() <= 600
            && (d.photoURL == ''
                || d.photoURL.matches('^https://firebasestorage[.]googleapis[.]com/.*')
                || d.photoURL.matches('^https://[^/]+[.]firebasestorage[.]app/.*'))))
        && (!('interests' in d) || (d.interests is list && d.interests.size() <= 9
            && d.interests.join('|').size() <= 600))
        && (!('bookedSlots' in d) || d.bookedSlots is list);
    }

    // Meeting map as showMeeting builds it: {loc, start, dur, day, dayLabel}.
    function validMeeting(m) {
      return m is map
        && m.keys().hasOnly(['loc','start','dur','day','dayLabel'])
        && m.day is string && m.day.matches('^[0-9]{8}$')
        && m.start is string && m.start.matches('^[0-9]{1,2}:[0-9]{2}$')
        && m.dur is number && m.dur >= 5 && m.dur <= 240
        && m.loc is string && m.loc.size() <= 120
        && m.dayLabel is string && m.dayLabel.size() <= 60;
    }

    match /participants/{uid} {
      allow read: if isDelegate() || isAdmin();
      allow create: if isAdmin()
        || (isDelegate() && request.auth.uid == uid
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 200
            && request.resource.data.status == 'approved'
            && (!('bookedSlots' in request.resource.data) || request.resource.data.bookedSlots.size() == 0)
            && !('email' in request.resource.data) && !('ticket' in request.resource.data)
            && validProfile(request.resource.data));
      allow update: if isAdmin()
        || (isDelegate() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['bookedSlots','status','source','registeredAt','email','ticket'])
            && validProfile(request.resource.data));
      allow delete: if isAdmin();

      match /private/{doc} {
        allow read: if isAdmin() || (isDelegate() && request.auth.uid == uid);
        allow write: if isAdmin() || (isDelegate() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['email','updatedAt'])
            && request.resource.data.email is string
            && request.resource.data.email.size() <= 200);
      }
    }

    // Collection-group reads (inbox / meetings listeners): only messages you are part of
    match /{path=**}/messages/{mid} {
      allow read: if isAdmin() || (isDelegate() && request.auth.uid in resource.data.participants);
    }

    match /threads/{tid} {
      allow read, write: if isAdmin();
      match /messages/{mid} {
        allow read: if inThread(tid) || isAdmin();
        allow create: if inThread(tid)
          && request.resource.data.fromId == request.auth.uid
          && request.resource.data.keys().hasOnly(['text','fromId','fromName','fromAvatar','ts','meeting','participants','hasMeeting'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && tid == request.resource.data.participants[0] + '__' + request.resource.data.participants[1]
          && request.resource.data.hasMeeting == ('meeting' in request.resource.data)
          && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 120
          && request.resource.data.fromAvatar is string && request.resource.data.fromAvatar.size() <= 600
          && (!('meeting' in request.resource.data) || validMeeting(request.resource.data.meeting));
        allow update: if inThread(tid)
          && resource.data.fromId != request.auth.uid
          && resource.data.get('meeting', null) != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resp'])
          && request.resource.data.resp in ['accepted','declined','busy'];
        allow delete: if isAdmin();
      }
    }
  }
}
